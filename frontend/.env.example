# Westphalia frontend environment.
#
# Copy to .env.local and adjust. Every value here is public: Next.js inlines
# NEXT_PUBLIC_* into the client bundle, so never put a key or secret in this
# file.

# Address of the deployed Westphalia intelligent contract.
# Defaults to the Studio Next deployment recorded in deployments/studio-dev.json.
# lib/networks.ts falls back to that same address when this is unset, so the
# app runs without any .env.local at all.
NEXT_PUBLIC_DIPLOMATIC_CONTRACT_ADDRESS=0x77810496d9a53c3c751E9E26Cf7191C71bDDB3C8

# RPC endpoint for the target network. GenLayer Studio Next is chain 61997; both
# hostnames below resolve to it and answer identically, so either works.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
